# Copy to .env.local and fill in.

# Required for the chatbot. Get one at https://aistudio.google.com/apikey
# Google rejects unrestricted keys, so add an API restriction (Generative
# Language API) and an application restriction before using it in production.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Overrides the chat model, so you can drop to a cheaper or
# higher-quota model without a code change.
# CHAT_MODEL=gemini-3.6-flash

# Optional. Per-IP rate limiting for /api/chat. Without these the limiter is a
# no-op, which is fine locally but leaves production unprotected.
# Free tier, no credit card: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Without this the contact form tells visitors to email directly
# instead of pretending to send. Free tier: https://resend.com
RESEND_API_KEY=
# Must be on a domain you verified with Resend. The default test sender only
# delivers to your own Resend account address.
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# Optional. Set once a custom domain is attached; otherwise Vercel's
# VERCEL_PROJECT_PRODUCTION_URL is used for canonical URLs and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://ranasohaib.vercel.app
